# ==============================================================================
# BolEnglish Environment Variables (All Optional)
# ==============================================================================
# When AI/STT keys are omitted, BolEnglish automatically uses the built-in
# offline diagnostic tutor and Windows/browser speech recognition fallbacks.

# AI Tutor Model (Anthropic Claude)
ANTHROPIC_API_KEY=""

# Server Speech-to-Text Fallback Providers
DEEPGRAM_API_KEY=""
OPENAI_API_KEY=""

# Public Canonical Origin for SEO Metadata (e.g. https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=""
